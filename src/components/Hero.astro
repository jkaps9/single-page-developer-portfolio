---
import RingsSvg from "@assets/images/pattern-rings.svg";
---

<section class="hero">
  <div class="svg">
    <RingsSvg />
  </div>
  <div class="container">
    <h1>Nice to meet you! I'm <span class="underline">Adam Keyes</span>.</h1>
    <p>
      Based in the UK, I’m a front-end developer passionate about building
      accessible web apps that users love.
    </p>
    <a href="#">Contact Me</a>
  </div>
</section>

<style lang="scss">
  .hero {
    padding-top: clamp(5rem, 23.2535rem + -20.2817vw, 18.5rem);
    position: relative;
    @include bp-max(md) {
      text-align: center;
    }
  }

  .svg {
    height: 129px;
    left: -355px;
    position: absolute;
    top: 0;
    width: 530px;
    z-index: -1;

    @include bp(lg) {
      left: -100px;
      top: 12px;
    }
  }

  .container {
    display: grid;
    gap: clamp(1.5rem, 0.6197rem + 3.7559vw, 4rem);
  }

  p {
    max-width: 445px;
  }
</style>
