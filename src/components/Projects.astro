---
import Project from "./Project.astro";

const projectItems = [
  {
    imagePath: "/src/assets/images/thumbnail-project-1-large.webp",
    title: "Design Portfolio",
    skills: ["HTML", "CSS"],
  },
  {
    imagePath: "/src/assets/images/thumbnail-project-2-large.webp",
    title: "E-Learning Landing Page",
    skills: ["HTML", "CSS"],
  },
  {
    imagePath: "/src/assets/images/thumbnail-project-3-large.webp",
    title: "Todo Web App",
    skills: ["HTML", "CSS", "Javascript"],
  },
  {
    imagePath: "/src/assets/images/thumbnail-project-4-large.webp",
    title: "Entertainment Web App",
    skills: ["HTML", "CSS", "Javascript"],
  },
  {
    imagePath: "/src/assets/images/thumbnail-project-5-large.webp",
    title: "Memory Game",
    skills: ["HTML", "CSS", "Javascript"],
  },
  {
    imagePath: "/src/assets/images/thumbnail-project-6-large.webp",
    title: "Art Gallery Showcase",
    skills: ["HTML", "CSS", "Javascript"],
  },
];
---

<section class="projects">
  <div class="container">
    <div class="title-row">
      <h2>Projects</h2>
      <a href="#">Contact Me</a>
    </div>
    <h3 class="sr-only">Project List</h3>
    <ul class="projects__list">
      {
        projectItems.map((item) => (
          <li class="projects__item">
            <Project
              imagePath={item.imagePath}
              title={item.title}
              skills={item.skills}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
  .title-row {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin-bottom: clamp(2.5rem, 1.6197rem + 3.7559vw, 5rem);
  }

  .projects {
    padding-bottom: clamp(5rem, 3.6796rem + 5.6338vw, 8.75rem);
    &__list {
      display: grid;
      gap: clamp(1.5rem, 0.5317rem + 4.1315vw, 4.25rem)
        clamp(1.5rem, 1.368rem + 0.5634vw, 1.875rem);
      @include bp(md) {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  }
</style>
