---
import GithubIcon from "@assets/images/icon-github.svg";
import FrontendMentorIcon from "@assets/images/icon-frontend-mentor.svg";
import LinkedinIcon from "@assets/images/icon-linkedin.svg";
import TwitterIcon from "@assets/images/icon-twitter.svg";

import Logo from "./Logo.astro";
---

<footer>
  <div class="container">
    <Logo />
    <ul class="socials">
      <li class="socials__item"><a href="#"><GithubIcon /></a></li>
      <li class="socials__item"><a href="#"><FrontendMentorIcon /></a></li>
      <li class="socials__item"><a href="#"><LinkedinIcon /></a></li>
      <li class="socials__item"><a href="#"><TwitterIcon /></a></li>
    </ul>
  </div>
</footer>

<style lang="scss">
  footer {
    background-color: var(--color-background-card);
  }
  .container {
    align-items: center;
    border-top: 1px solid var(--color-header-text);
    display: flex;
    flex-direction: column;
    padding-block: clamp(1.25rem, 0.6338rem + 2.6291vw, 3rem);

    @include bp-max(md) {
      gap: 1.25rem;
    }

    @include bp(md) {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .socials {
    display: flex;
    justify-content: space-between;

    @include bp-max(md) {
      max-width: 174px;
      width: stretch;
    }

    @include bp(md) {
      gap: 2rem;
    }
  }
</style>
