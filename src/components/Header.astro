---
import GithubIcon from "@assets/images/icon-github.svg";
import FrontendMentorIcon from "@assets/images/icon-frontend-mentor.svg";
import LinkedinIcon from "@assets/images/icon-linkedin.svg";
import TwitterIcon from "@assets/images/icon-twitter.svg";
---

<header>
  <div class="container">
    <div class="logo">
      <p>adamkeyes</p>
    </div>
    <ul class="socials">
      <li class="socials__item"><GithubIcon /></li>
      <li class="socials__item"><FrontendMentorIcon /></li>
      <li class="socials__item"><LinkedinIcon /></li>
      <li class="socials__item"><TwitterIcon /></li>
    </ul>
    <div class="header__image">
      <picture>
        <source
          srcset="/src/assets/images/image-profile-desktop.webp"
          media="(min-width:1024px)"
        />
        <source
          srcset="/src/assets/images/image-profile-tablet.webp"
          media="(min-width:768px)"
        />
        <img
          src="/src/assets/images/image-profile-mobile.webp"
          alt="Adam Keyes headshot"
        />
      </picture>
    </div>
  </div>
</header>

<style lang="scss">
  header {
    position: relative;
    z-index: 10;
  }
  .container {
    align-items: center;
    display: flex;
    flex-direction: column;
    padding-block: clamp(1.25rem, 0.6338rem + 2.6291vw, 3rem);

    @include bp-max(md) {
      gap: 1.25rem;
      max-width: 174px;
    }

    @include bp(md) {
      flex-direction: row;
      justify-content: space-between;
    }

    .logo,
    .socials {
      position: relative;
      z-index: 10;
    }
  }

  .header__image {
    position: absolute;
    right: 0;
    top: 0;
    z-index: 9;
    @include bp-max(md) {
      left: 0;
      max-width: 174px;
      margin: 0 auto;
    }

    @include bp(md) {
      right: -5%;
      max-width: 322px;
    }

    @include bp(lg) {
      right: -1.5rem;
      max-width: 445px;
    }
  }

  .logo {
    flex: 1;
  }

  .logo p {
    color: var(--color-header-text);
    font-size: clamp(1.5rem, 1.3239rem + 0.7512vw, 2rem);
  }

  .socials {
    display: flex;
    justify-content: space-between;

    @include bp-max(md) {
      width: stretch;
    }

    @include bp(md) {
      gap: 2rem;
    }
  }
</style>
