---
const skills = [
  { title: "HTML", yearsExperience: 4 },
  { title: "CSS", yearsExperience: 4 },
  { title: "Javascript", yearsExperience: 4 },
  { title: "Accessibility", yearsExperience: 4 },
  { title: "React", yearsExperience: 3 },
  { title: "Sass", yearsExperience: 3 },
];
---

<section class="skills">
  <div class="container">
    <ul class="skills__list">
      {
        skills.map((skill) => (
          <li class="skills__item">
            <h3>{skill.title}</h3>
            <p>{skill.yearsExperience} Years Experience</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
  .skills {
    .container {
      border-top: 1px solid var(--color-header-text);
      padding-block: clamp(2.5rem, 1.7958rem + 3.0047vw, 4.5rem);

      @include bp-max(md) {
        border-bottom: 1px solid var(--color-header-text);
      }
    }
    &__list {
      display: grid;
      gap: clamp(1.5rem, 0.7518rem + 3.1925vw, 3.625rem)
        clamp(1.5rem, 1.368rem + 0.5634vw, 1.875rem);
      grid-template-columns: repeat(auto-fit, minmax(345px, 1fr));
      text-align: center;

      @include bp(md) {
        text-align: start;
      }
    }
    &__item {
      display: grid;
      gap: clamp(0.0625rem, -0.2236rem + 1.2207vw, 0.875rem);
    }
  }
</style>
